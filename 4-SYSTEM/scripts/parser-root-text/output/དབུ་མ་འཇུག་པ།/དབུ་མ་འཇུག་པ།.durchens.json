{
  "durchens": [
    {
      "span": {
        "start": 31,
        "end": 35
      },
      "text": "ཀ་ཨ་ ༼སྣར། པེ།༽ ཀཱ་"
    },
    {
      "span": {
        "start": 495,
        "end": 505
      },
      "text": "གྱུར་ཅིང་། ༼སྡེ།༽ གྱུར་ཞིང་།"
    },
    {
      "span": {
        "start": 507,
        "end": 514
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 780,
        "end": 790
      },
      "text": "གྱུར་ཅིང་། ༼ཅོ། སྡེ།༽ གྱུར་ཞིང་།"
    },
    {
      "span": {
        "start": 1196,
        "end": 1203
      },
      "text": "གོང་མར་ ༼སྣར། པེ།༽ གོང་མ་"
    },
    {
      "span": {
        "start": 1476,
        "end": 1482
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 2325,
        "end": 2334
      },
      "text": "བྱིན་ཅིག་ ༼ཅོ། སྡེ།༽ བྱིན་ཞིག་"
    },
    {
      "span": {
        "start": 2573,
        "end": 2576
      },
      "text": "ནི། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 2699,
        "end": 2707
      },
      "text": "གསུམ་པོ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 2845,
        "end": 2850
      },
      "text": "རྙེད་ ༼སྣར། པེ།༽ སྙེད་"
    },
    {
      "span": {
        "start": 3116,
        "end": 3123
      },
      "text": "སོག་པར་ ༼སྣར། པེ།༽ གསོག་པར་"
    },
    {
      "span": {
        "start": 3496,
        "end": 3503
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 3976,
        "end": 3983
      },
      "text": "ལེགས་པ་ ༼སྣར།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 4000,
        "end": 4008
      },
      "text": "རྒྱུ་ནི་ ༼པེ།༽ རྒྱུའི་"
    },
    {
      "span": {
        "start": 4905,
        "end": 4913
      },
      "text": "ཆོས་ཀྱང་ ༼སྣར། པེ།༽ ཆོས་ཀུན་"
    },
    {
      "span": {
        "start": 4926,
        "end": 4931
      },
      "text": "བརྙན་ ༼སྣར།༽ བསྙན་"
    },
    {
      "span": {
        "start": 4999,
        "end": 5004
      },
      "text": "བཀོན་ ༼སྣར། པེ།༽ དཀོན་"
    },
    {
      "span": {
        "start": 5050,
        "end": 5054
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 5091,
        "end": 5100
      },
      "text": "ཕ་རོལ་དང་ ༼སྣར། པེ།༽ ཕ་རོལ་ཡང་"
    },
    {
      "span": {
        "start": 5272,
        "end": 5281
      },
      "text": "འཁྲིད་པར་ ༼སྣར། པེ།༽ ཁྲིད་པར་"
    },
    {
      "span": {
        "start": 5469,
        "end": 5476
      },
      "text": "མིན་པར་ ༼སྣར། པེ།༽ མིན་པ་"
    },
    {
      "span": {
        "start": 5830,
        "end": 5834
      },
      "text": "རིག་ ༼པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 6067,
        "end": 6076
      },
      "text": "ཕྱིན་ཅེས་ ༼ཅོ། སྡེ།༽ ཕྱིན་ཞེས་"
    },
    {
      "span": {
        "start": 6723,
        "end": 6730
      },
      "text": "གྱུར་པ་ ༼སྣར།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 6753,
        "end": 6758
      },
      "text": "འཕྲོ་ ༼སྣར། པེ།༽ འགྲོ་"
    },
    {
      "span": {
        "start": 6819,
        "end": 6828
      },
      "text": "བསྒོམས་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 6895,
        "end": 6901
      },
      "text": "འབྲེལ་ ༼སྣར། པེ།༽ འགྲེལ་"
    },
    {
      "span": {
        "start": 7233,
        "end": 7243
      },
      "text": "འཇིག་རྟེན་ ༼སྣར། པེ།༽ འདི་བརྟེན་"
    },
    {
      "span": {
        "start": 7390,
        "end": 7398
      },
      "text": "འཁྲིད་པ་ ༼སྣར། པེ།༽ ཁྲིད་པ་"
    },
    {
      "span": {
        "start": 8021,
        "end": 8029
      },
      "text": "སྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 8406,
        "end": 8412
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 9150,
        "end": 9153
      },
      "text": "དག་ ༼སྣར། པེ།༽ ང་"
    },
    {
      "span": {
        "start": 9765,
        "end": 9771
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 9815,
        "end": 9824
      },
      "text": "གཏོགས་དང་ ༼སྣར། པེ།༽ གཏོགས་པ་"
    },
    {
      "span": {
        "start": 10365,
        "end": 10368
      },
      "text": "ནི་ ༼ཅོ། སྡེ།༽ ན་"
    },
    {
      "span": {
        "start": 10488,
        "end": 10494
      },
      "text": "དེ་ཡང་ ༼སྣར། པེ།༽ དེ་ཡོད་"
    },
    {
      "span": {
        "start": 10528,
        "end": 10537
      },
      "text": "ཕྱོགས་པས་ ༼སྣར། པེ།༽ ཕྱོགས་པ་"
    },
    {
      "span": {
        "start": 10925,
        "end": 10933
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 10990,
        "end": 10996
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 11159,
        "end": 11165
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 11320,
        "end": 11328
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 11421,
        "end": 11429
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 11461,
        "end": 11471
      },
      "text": "བརྫུན་པའང་ ༼སྣར། པེ།༽ རྫུན་པའང་"
    },
    {
      "span": {
        "start": 11777,
        "end": 11784
      },
      "text": "བསྐྱོང་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 11895,
        "end": 11903
      },
      "text": "ཀྱང་ཡོད་ ༼སྣར། པེ།༽ ཀྱང་ཡང་"
    },
    {
      "span": {
        "start": 12050,
        "end": 12054
      },
      "text": "ཡིན། ༼སྣར།༽ མིན།"
    },
    {
      "span": {
        "start": 12105,
        "end": 12110
      },
      "text": "བཅོས་ ༼སྣར། པེ།༽ བཅོམ་"
    },
    {
      "span": {
        "start": 12442,
        "end": 12450
      },
      "text": "ལམ་གྱིས་ ༼སྣར། པེ།༽ ལམ་གྱི་"
    },
    {
      "span": {
        "start": 12706,
        "end": 12712
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 12739,
        "end": 12745
      },
      "text": "བཙུགས་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 12755,
        "end": 12760
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 12989,
        "end": 12997
      },
      "text": "སྐུར་བས་ ༼སྣར།༽ བྱུང་ལ་"
    },
    {
      "span": {
        "start": 13289,
        "end": 13292
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 13304,
        "end": 13312
      },
      "text": "མིན་པའི། ༼སྣར། པེ།༽ མིན་པ།"
    },
    {
      "span": {
        "start": 13913,
        "end": 13925
      },
      "text": "རང་བཞིན་ཡོད་ ༼ཅོ། སྡེ།༽ རང་བཞིན་ཡང་"
    },
    {
      "span": {
        "start": 13956,
        "end": 13962
      },
      "text": "ཡོད་པ་ ༼ཅོ། སྡེ།༽ ཡོད་མ་"
    },
    {
      "span": {
        "start": 14370,
        "end": 14377
      },
      "text": "རིག་པར་ ༼སྣར།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 14873,
        "end": 14881
      },
      "text": "དངོས་པོ་ ༼སྣར།༽ དངོས་"
    },
    {
      "span": {
        "start": 15275,
        "end": 15277
      },
      "text": "ན་ ༼ཅོ། སྡེ།༽ ནང་"
    },
    {
      "span": {
        "start": 15451,
        "end": 15455
      },
      "text": "ཡིད་ ༼ཅོ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 15498,
        "end": 15504
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 15533,
        "end": 15541
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 15629,
        "end": 15635
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 15733,
        "end": 15735
      },
      "text": "མ་ ༼ཅོ། སྡེ།༽ མི་"
    },
    {
      "span": {
        "start": 15962,
        "end": 15970
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 16616,
        "end": 16625
      },
      "text": "རྒྱུན་ཅན་ ༼སྣར། པེ།༽ རྒྱུ་ཅན་"
    },
    {
      "span": {
        "start": 16881,
        "end": 16883
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 16926,
        "end": 16931
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 17001,
        "end": 17008
      },
      "text": "གང་ཞིག་ ༼སྣར།༽ གང་དག་"
    },
    {
      "span": {
        "start": 17018,
        "end": 17021
      },
      "text": "ཐག་ ༼སྣར།༽ འོག་"
    },
    {
      "span": {
        "start": 17243,
        "end": 17251
      },
      "text": "བཟུང་བར་ ༼སྣར། པེ།༽ གཟུང་བར་"
    },
    {
      "span": {
        "start": 17631,
        "end": 17637
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 17791,
        "end": 17801
      },
      "text": "བརྫུན་པའི་ ༼སྣར། པེ།༽ རྫུན་པའི་"
    },
    {
      "span": {
        "start": 18095,
        "end": 18102
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 18236,
        "end": 18242
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 18248,
        "end": 18257
      },
      "text": "བརྫུན་པར་ ༼སྣར། པེ།༽ རྫུན་པར་"
    },
    {
      "span": {
        "start": 18295,
        "end": 18303
      },
      "text": "མཚུངས་ལ། ༼སྣར། པེ།༽ མཚུངས་པ།"
    },
    {
      "span": {
        "start": 18582,
        "end": 18588
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 18636,
        "end": 18646
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར།༽ བསྒྲུབས་པར་"
    },
    {
      "span": {
        "start": 18999,
        "end": 19006
      },
      "text": "རང་རིག་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 19213,
        "end": 19219
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པར་"
    },
    {
      "span": {
        "start": 19443,
        "end": 19446
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19642,
        "end": 19645
      },
      "text": "གང་ ༼སྣར།༽ གང་གང་"
    },
    {
      "span": {
        "start": 19702,
        "end": 19712
      },
      "text": "ཁྱོད་ཀྱིས་ ༼པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 21371,
        "end": 21376
      },
      "text": "ཅིག ། ༼ཅོ། སྡེ།༽ ཞིག །"
    },
    {
      "span": {
        "start": 21385,
        "end": 21389
      },
      "text": "ཉིད་ ༼ཅོ། སྡེ།༽ འདི་"
    },
    {
      "span": {
        "start": 21410,
        "end": 21415
      },
      "text": "ཅིག ། ༼ཅོ། སྡེ།༽ ཞིག །"
    },
    {
      "span": {
        "start": 21601,
        "end": 21606
      },
      "text": "གདོད་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 21976,
        "end": 21980
      },
      "text": "བླག་ ༼སྣར། པེ།༽ གླག་"
    },
    {
      "span": {
        "start": 22230,
        "end": 22238
      },
      "text": "གཉིས་ལས་ ༼སྣར། པེ།༽ གཉིས་ལམ་"
    },
    {
      "span": {
        "start": 22755,
        "end": 22770
      },
      "text": "འཛིན་པའང་དེ་ཡི་ ༼སྣར། པེ།༽ འཛིན་པའང་ཡིན་དེའི་"
    },
    {
      "span": {
        "start": 23414,
        "end": 23420
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་དམ་"
    },
    {
      "span": {
        "start": 23717,
        "end": 23721
      },
      "text": "ལོག་ ༼པེ།༽ ལོགས་"
    },
    {
      "span": {
        "start": 23799,
        "end": 23802
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 23930,
        "end": 23939
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 24604,
        "end": 24608
      },
      "text": "སྨྲ་ ༼ཅོ། སྡེ།༽ ས་"
    },
    {
      "span": {
        "start": 24876,
        "end": 24883
      },
      "text": "གྱུར་པ། ༼སྣར།༽ གྱུར་ལ ༼པེ།༽ འགྱུར་ལ།"
    },
    {
      "span": {
        "start": 24900,
        "end": 24907
      },
      "text": "སྐྱེ་བ་ ༼ཅོ། སྡེ།༽ སྐྱེ་བོ་"
    },
    {
      "span": {
        "start": 25017,
        "end": 25026
      },
      "text": "འབྱུང་བས་ ༼སྣར། པེ།༽ འགྱུར་བས་"
    },
    {
      "span": {
        "start": 25074,
        "end": 25079
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 25291,
        "end": 25296
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 25355,
        "end": 25360
      },
      "text": "རྟོག་ ༼ཅོ། སྡེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 25379,
        "end": 25387
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 26019,
        "end": 26029
      },
      "text": "གྱུར་ཞིང་། ༼སྣར། པེ།༽ གྱུར་ཅིང་།"
    },
    {
      "span": {
        "start": 26532,
        "end": 26536
      },
      "text": "ཁྱད་ ༼སྣར། པེ།༽ བྱད་"
    },
    {
      "span": {
        "start": 26578,
        "end": 26589
      },
      "text": "བདག་མེད་དེ། ༼སྣར། པེ།༽ བདག་མེད་དོ།"
    },
    {
      "span": {
        "start": 26712,
        "end": 26721
      },
      "text": "དུད་འགྲོ་ ༼སྣར། པེ།༽ དུད་འགྲོར་"
    },
    {
      "span": {
        "start": 26729,
        "end": 26735
      },
      "text": "བརྐྱལ་ ༼སྣར། པེ།༽ རྐྱལ་"
    },
    {
      "span": {
        "start": 26744,
        "end": 26748
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 27508,
        "end": 27513
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 28335,
        "end": 28345
      },
      "text": "དབྱིབས་ཤེ་ ༼སྣར། པེ།༽ དབྱིབས་ཞེ་"
    },
    {
      "span": {
        "start": 28419,
        "end": 28424
      },
      "text": "ཚོགས་ ༼སྣར། པེ།༽ ཚུགས་"
    },
    {
      "span": {
        "start": 28485,
        "end": 28492
      },
      "text": "ལེན་པོ་ ༼སྣར། པེ།༽ ལེན་པོར་"
    },
    {
      "span": {
        "start": 28759,
        "end": 28765
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 29150,
        "end": 29160
      },
      "text": "སྦྲུལ་གྱི་ ༼སྣར། པེ།༽ སྦྲུལ་གྱིས་"
    },
    {
      "span": {
        "start": 30657,
        "end": 30663
      },
      "text": "ལ་མིན་ ༼སྣར། པེ།༽ མ་ཡིན་"
    },
    {
      "span": {
        "start": 31020,
        "end": 31028
      },
      "text": "ཉིད་དུས་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 31596,
        "end": 31602
      },
      "text": "དུ་འམ་ ༼སྣར། པེ།༽ དུ་ལས་"
    },
    {
      "span": {
        "start": 32048,
        "end": 32052
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ རྨིན་"
    },
    {
      "span": {
        "start": 32345,
        "end": 32354
      },
      "text": "བརྟན་མིན་ ༼སྣར།༽ བརྟེན་མིང་ ༼པེ།༽ བརྟན་མིང་"
    },
    {
      "span": {
        "start": 32460,
        "end": 32464
      },
      "text": "མིན། ༼སྣར། པེ།༽ མེད།"
    },
    {
      "span": {
        "start": 32466,
        "end": 32474
      },
      "text": "གང་ཕྱིར་ ༼སྣར། པེ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 32579,
        "end": 32585
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 32906,
        "end": 32913
      },
      "text": "བསྙད་པ་ ༼སྣར། པེ།༽ བསྙེད་པ་"
    },
    {
      "span": {
        "start": 33255,
        "end": 33261
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 34022,
        "end": 34025
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 34300,
        "end": 34306
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་མི་"
    },
    {
      "span": {
        "start": 34991,
        "end": 34994
      },
      "text": "བྱ། ༼སྣར།༽ བྱར།"
    },
    {
      "span": {
        "start": 35222,
        "end": 35230
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 35246,
        "end": 35251
      },
      "text": "གཞུག་ ༼སྣར།༽ གཞུགས་"
    },
    {
      "span": {
        "start": 35259,
        "end": 35266
      },
      "text": "ཞུས་པར་ ༼སྣར། པེ།༽ ནུས་པར་"
    },
    {
      "span": {
        "start": 35273,
        "end": 35281
      },
      "text": "ཇི་ལ་དེ་ ༼སྣར། པེ།༽ ཇི་"
    },
    {
      "span": {
        "start": 35392,
        "end": 35397
      },
      "text": "རྩོལ་ ༼སྣར། པེ།༽ བཅོལ་"
    },
    {
      "span": {
        "start": 35590,
        "end": 35599
      },
      "text": "རྟོགས་པར་ ༼སྣར།༽ རྟོགས་པར་པར་"
    },
    {
      "span": {
        "start": 35626,
        "end": 35631
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 35716,
        "end": 35724
      },
      "text": "གདུལ་བྱ་ ༼སྣར། པེ།༽ གདུལ་བ་"
    },
    {
      "span": {
        "start": 35743,
        "end": 35746
      },
      "text": "མང་ ༼སྣར།༽ མེད་"
    },
    {
      "span": {
        "start": 35792,
        "end": 35799
      },
      "text": "བཤད་ནས་ ༼སྣར།༽ བཤད་ཞེས་"
    },
    {
      "span": {
        "start": 35822,
        "end": 35827
      },
      "text": "བཞིར་ ༼སྣར། པེ།༽ གཞིར་"
    },
    {
      "span": {
        "start": 35960,
        "end": 35969
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱང་"
    },
    {
      "span": {
        "start": 36470,
        "end": 36483
      },
      "text": "སྟོང་ཉིད་ཅེས་ ༼སྣར། པེ།༽ སྟོང་ཉིད་ཞེས་"
    },
    {
      "span": {
        "start": 36524,
        "end": 36532
      },
      "text": "འདོད་དེ། ༼སྣར།༽ འདོད་དོ།"
    },
    {
      "span": {
        "start": 36663,
        "end": 36671
      },
      "text": "མེད་དཔེ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 37131,
        "end": 37138
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 37240,
        "end": 37246
      },
      "text": "ནི་དེ་ ༼པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 37611,
        "end": 37621
      },
      "text": "དོར་བ་ཅེས་ ༼སྣར། པེ།༽ དོར་བ་ཞེས་"
    },
    {
      "span": {
        "start": 37664,
        "end": 37672
      },
      "text": "དོར་མེད་ ༼ཅོ།༽ དོན་མེད་"
    },
    {
      "span": {
        "start": 38989,
        "end": 38995
      },
      "text": "འཁྲུག་ ༼སྣར། པེ།༽ འཁྲུགས་"
    },
    {
      "span": {
        "start": 39399,
        "end": 39402
      },
      "text": "ནི། ༼ཅོ། སྡེ།༽ ན།"
    },
    {
      "span": {
        "start": 39595,
        "end": 39602
      },
      "text": "ཅན་ཞེས་ ༼སྣར། པེ།༽ ཅན་ཤེས་"
    },
    {
      "span": {
        "start": 39671,
        "end": 39676
      },
      "text": "སྟོན་ ༼ཅོ། སྡེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 39900,
        "end": 39906
      },
      "text": "རེ་རེ་ ༼སྣར། པེ།༽ དེ་དེ་"
    },
    {
      "span": {
        "start": 40118,
        "end": 40127
      },
      "text": "མིན་འཇིག་ ༼སྣར།༽ མི་འཇིག་ ༼པེ།༽ མི་འཇིགས་"
    },
    {
      "span": {
        "start": 40131,
        "end": 40134
      },
      "text": "པས། ༼སྣར། པེ།༽ པ།"
    },
    {
      "span": {
        "start": 40780,
        "end": 40785
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 41519,
        "end": 41525
      },
      "text": "འགྱུར་ ༼ཅོ། སྡེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 42449,
        "end": 42466
      },
      "text": "བྱུང་བར་གྱུར་པའང་ ༼སྣར།༽ བྱུང་བ་འགྱུར་བའང་"
    },
    {
      "span": {
        "start": 42684,
        "end": 42694
      },
      "text": "བྱིན་གྱིས་ ༼ཅོ། སྡེ།༽ བྱིན་གྱི་"
    },
    {
      "span": {
        "start": 43536,
        "end": 43549
      },
      "text": "ཁྲག་ཁྲིག་ཕྲག་ ༼པེ།༽ ཁྲག་ཁྲིག་"
    },
    {
      "span": {
        "start": 43564,
        "end": 43571
      },
      "text": "བསྒྱུར་ ༼ཅོ། སྡེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 44362,
        "end": 44372
      },
      "text": "གྱུར་ཞིང་། ༼སྣར། པེ།༽ གྱུར་ཅིང་།"
    },
    {
      "span": {
        "start": 44611,
        "end": 44618
      },
      "text": "ཆུད་པར་ ༼སྣར། པེ།༽ ཆུད་པ་"
    },
    {
      "span": {
        "start": 44778,
        "end": 44787
      },
      "text": "རིགས་པའང་ ༼སྣར།༽ རིགས་ཀྱང་ ༼པེ།༽ རིག་པའང་"
    },
    {
      "span": {
        "start": 44983,
        "end": 44988
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 45116,
        "end": 45122
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 45763,
        "end": 45773
      },
      "text": "གྱུར་ཞིང་། ༼སྣར། པེ།༽ གྱུར་ཅིང་།"
    },
    {
      "span": {
        "start": 47001,
        "end": 47005
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ གུལ་"
    },
    {
      "span": {
        "start": 47311,
        "end": 47315
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 47734,
        "end": 47740
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློག་"
    },
    {
      "span": {
        "start": 47744,
        "end": 47748
      },
      "text": "མིན་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 47840,
        "end": 47843
      },
      "text": "ཟད་ ༼སྣར། པེ།༽ ཟས་"
    },
    {
      "span": {
        "start": 48119,
        "end": 48123
      },
      "text": "ལའང་ ༼ཅོ། སྡེ།༽ ལ་"
    },
    {
      "span": {
        "start": 48164,
        "end": 48174
      },
      "text": "སྟོབས་ཞེས་ ༼ཅོ། སྡེ།༽ སྟོབས་ཤེས་"
    },
    {
      "span": {
        "start": 48214,
        "end": 48224
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 48376,
        "end": 48381
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 48768,
        "end": 48792
      },
      "text": "བསམ་གཏན་རྣམ་ཐར་བརྒྱད་གང་ ༼སྣར། པེ།༽ བསམ་གཏན་མཐར་བརྒྱད་"
    },
    {
      "span": {
        "start": 48840,
        "end": 48843
      },
      "text": "པར་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 49013,
        "end": 49018
      },
      "text": "གཞིར་ ༼སྣར། པེ།༽ བཞིར་"
    },
    {
      "span": {
        "start": 49152,
        "end": 49159
      },
      "text": "ནམ་མཁའ་ ༼སྣར། པེ།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 49327,
        "end": 49330
      },
      "text": "བག་ ༼སྣར།༽ བག་མ་"
    },
    {
      "span": {
        "start": 49491,
        "end": 49495
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 49878,
        "end": 49886
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 50030,
        "end": 50035
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ ཁྱེད་"
    },
    {
      "span": {
        "start": 50073,
        "end": 50079
      },
      "text": "ཞགས་པ་ ༼པེ།༽ ཞབས་པ་"
    },
    {
      "span": {
        "start": 50309,
        "end": 50315
      },
      "text": "ཡིན་ལ། ༼སྣར། པེ།༽ ཡིན་པ།"
    },
    {
      "span": {
        "start": 50880,
        "end": 50890
      },
      "text": "ཕྱོགས་ཤིང་ ༼སྣར། པེ།༽ ཕྱོགས་ཞིང་"
    },
    {
      "span": {
        "start": 51043,
        "end": 51048
      },
      "text": "བསྙད་ ༼སྣར།༽ བསྙད་ན་"
    },
    {
      "span": {
        "start": 51688,
        "end": 51698
      },
      "text": "ཐུགས་རྗེས་ ༼སྣར།༽ ཐུགས་རྗེའི་"
    },
    {
      "span": {
        "start": 51703,
        "end": 51708
      },
      "text": "ཐུགས་ ༼སྣར།༽ ལུགས་"
    },
    {
      "span": {
        "start": 51938,
        "end": 51944
      },
      "text": "གཞན་ན་ ༼སྣར།༽ གཞན་"
    },
    {
      "span": {
        "start": 52114,
        "end": 52116
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 52594,
        "end": 52603
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 52694,
        "end": 52704
      },
      "text": "བདེ་གཤེགས་ ༼སྣར། པེ།༽ བདེར་གཤེགས་"
    },
    {
      "span": {
        "start": 52756,
        "end": 52763
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 52880,
        "end": 52885
      },
      "text": "དྲུས་ ༼པེ།༽ དྲུས་མ་"
    }
  ]
}